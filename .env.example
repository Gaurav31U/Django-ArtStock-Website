# Copy to .env and fill in. Every value is optional for local development.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://artstock.example.com
SITE_URL=http://127.0.0.1:8000

# Database: SQLite by default. For Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/artstock

# Cache: in-memory by default.
# REDIS_URL=redis://localhost:6379/1

# Razorpay test keys from https://dashboard.razorpay.com/app/keys (use rzp_test_... keys while developing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email: printed to the console unless EMAIL_HOST is set.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=ArtStock <no-reply@example.com>
